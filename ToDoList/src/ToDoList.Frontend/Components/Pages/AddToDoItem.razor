@page "/addToDoItem"
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@using Microsoft.AspNetCore.Components.Forms

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<h2>Přidat nový úkol</h2>

<EditForm Model="ToDoItemModel" FormName="AddToDoItem" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="Name" class="form-label">Název</label>
        <InputText id="Name" @bind-Value="ToDoItemModel.Name" class="form-control w-25" />
        <ValidationMessage For="() => ToDoItemModel.Name" />
    </div>
    <div class="mb-3">
        <label for="Description" class="form-label">Popis</label>
        <InputText id="Description" @bind-Value="ToDoItemModel.Description" class="form-control w-25" />
        <ValidationMessage For="() => ToDoItemModel.Description" />
    </div>
    <div class="mb-3">
        <label for="IsCompleted" class="form-label">Dokončený</label>
        <InputCheckbox id="IsCompleted" @bind-Value="ToDoItemModel.IsCompleted" />
    </div>
    <div class="mb-3">
        <label for="Category" class="form-label">Kategorie</label>
        <InputText id="Category" @bind-Value="ToDoItemModel.Category" class="form-control w-25" />
    </div>
    <div>
        <span class="text-danger">@errorMessage</span>
    </div>
    <button class="btn btn-primary" type="submit">Odeslat</button>
</EditForm>

@code {
    string errorMessage = string.Empty;

    public ToDoItemView ToDoItemModel { get; set; } = new ToDoItemView
    {
        Name = string.Empty,
        Description = string.Empty,
        IsCompleted = false,
        Category = string.Empty
    };


    public async Task Submit()
    {
        await toDoItemsClient.CreateItemAsync(ToDoItemModel);
        NavigationManager.NavigateTo("/");
    }
}
