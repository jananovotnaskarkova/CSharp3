@page "/editToDoItem/{ItemId:int}"
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@using Microsoft.AspNetCore.Components.Forms

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<h2>Upravit úkol č. @ItemId</h2>

@if (ToDoItemModel != null)
{
    <EditForm Model="ToDoItemModel" FormName="EditToDoItem" OnSubmit="Submit">
        <div class="mb-3">
            <label for="Name" class="form-label">Název</label>
            <InputText id="Name" @bind-Value="ToDoItemModel.Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="Description" class="form-label">Popis</label>
            <InputText id="Description" @bind-Value="ToDoItemModel.Description" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="IsCompleted" class="form-label">Dokončený</label>
            <InputCheckbox id="IsCompleted" @bind-Value="ToDoItemModel.IsCompleted" />
        </div>
        <div class="mb-3">
            <label for="Category" class="form-label">Kategorie</label>
            <InputText id="Category" @bind-Value="ToDoItemModel.Category" class="form-control" />
        </div>
        <div>
            <span class="text-danger">@errorMessage</span>
        </div>
        <button class="btn btn-primary" type="submit">Odeslat</button>
    </EditForm>
}

@code {
    string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ToDoItemModel = await toDoItemsClient.ReadItemByIdAsync(ItemId);
    }

    [Parameter]
    public int ItemId { get; set; }

    [SupplyParameterFromForm]
    public ToDoItemView? ToDoItemModel { get; set; }

    public async Task Submit()
    {
        if (ToDoItemModel == null)
            return;

        if (ToDoItemModel.Name != string.Empty && ToDoItemModel.Description != string.Empty)
        {
            await toDoItemsClient.UpdateItemAsync(ToDoItemModel);
            NavigationManager.NavigateTo("/");
        }
        if (ToDoItemModel.Name == string.Empty && ToDoItemModel.Description != string.Empty)
        {
            errorMessage = "Název nesmí být prázdný.";
        }
        if (ToDoItemModel.Description == string.Empty && ToDoItemModel.Name != string.Empty)
        {
            errorMessage = "Popis nesmí být prázdný.";
        }
        if (ToDoItemModel.Name == string.Empty && ToDoItemModel.Description == string.Empty)
        {
            errorMessage = "Název a popis nesmí být prázdné.";
        }
    }
}
