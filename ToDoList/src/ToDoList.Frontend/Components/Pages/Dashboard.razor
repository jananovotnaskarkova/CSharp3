@using System.Runtime.InteropServices
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<button class="btn btn-warning mb-3" @onclick="AddItem">Přidat nový úkol</button>

<div>
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>
                    <button class=@class_button_id @onclick="SortById">ID</button>
                </th>
                <th>
                    <button class=@class_button_name @onclick="SortByName">Název</button>
                </th>
                <th>
                    <button class=@class_button_description @onclick="SortByDescription">Popis</button>
                </th>
                <th>
                    <button class=@class_button_completed @onclick="SortByCompletedFirstCompleted">Dokončeno</button>
                </th>
                <th>
                    <button class=@class_button_category @onclick="SortByCategory">Kategorie</button>
                </th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in testData)
            {
                <tr class=@SetRowClass(item)>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Dokončený" : "Nedokončený")</td>
                    <td>@item.Category</td>
                    <td>
                        <button class="btn btn-secondary" @onclick="() => EditItem(item)">Upravit</button>
                        <button class="btn btn-secondary" @onclick="() => DeleteItem(item)">Smazat</button>
                        <button class="btn btn-secondary" @onclick="() => ChangeIsCompletedStatus(item)">Změnit
                            stav</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    string class_button_id = "btn btn-success";
    string class_button_name = "btn btn-primary";
    string class_button_description = "btn btn-primary";
    string class_button_not_completed = "btn btn-primary";
    string class_button_completed = "btn btn-primary";
    string class_button_category = "btn btn-primary";

    private List<ToDoItemView> testData = new() { };

    private void SortById()
    {
        testData = testData.OrderBy(i => i.Id).ToList();
        SetButtonClasses("id");
        StateHasChanged();
    }

    private void SortByName()
    {
        testData = testData.OrderBy(i => i.Name).ToList();
        SetButtonClasses("name");
        StateHasChanged();
    }

    private void SortByDescription()
    {
        testData = testData.OrderBy(i => i.Description).ToList();
        SetButtonClasses("description");
        StateHasChanged();
    }

    private void SortByCompletedFirstCompleted()
    {
        testData = testData.OrderByDescending(i => i.IsCompleted).ToList();
        SetButtonClasses("completed");
        StateHasChanged();
    }

    private void SortByCategory()
    {
        testData = testData.OrderBy(i => i.Category).ToList();
        SetButtonClasses("category");
        StateHasChanged();
    }

    private void SetButtonClasses(string activeClass)
    {
        class_button_id = activeClass == "id" ? "btn btn-success" : "btn btn-primary";
        class_button_name = activeClass == "name" ? "btn btn-success" : "btn btn-primary";
        class_button_description = activeClass == "description" ? "btn btn-success" : "btn btn-primary";
        class_button_not_completed = activeClass == "not_completed" ? "btn btn-success" : "btn btn-primary";
        class_button_completed = activeClass == "completed" ? "btn btn-success" : "btn btn-primary";
        class_button_category = activeClass == "category" ? "btn btn-success" : "btn btn-primary";
    }

    private string SetRowClass(ToDoItemView item)
    {
        return item.IsCompleted ? "table-success" : "table-light";
    }
    private void EditItem(ToDoItemView item)
    {
        NavigationManager.NavigateTo($"editToDoItem/{item.Id}");
    }
    private void AddItem()
    {
        NavigationManager.NavigateTo($"addToDoItem");
    }
    private void DeleteItem(ToDoItemView item)
    {
        toDoItemsClient.DeleteItemAsync(item.Id);
        testData.Remove(item);
    }
    private void ChangeIsCompletedStatus(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;
        toDoItemsClient.UpdateItemAsync(item);
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        testData = await toDoItemsClient.ReadItemsAsync();
    }
}